# Copy to .env for local development. Never commit .env.
#
# GoHighLevel inbound webhook that starts the lead magnet automation.
# In GHL: Automation, the workflow, trigger "Inbound Webhook", copy the URL.
# On Vercel set the same name under Project, Settings, Environment Variables.
GHL_WEBHOOK_URL=

# Notion: the internal integration secret and the ID of Damon's posts
# database (the 32 characters in the database URL). With both set,
# "npm run build" refreshes src/content/leadMagnets.generated.js from the
# rows ticked "Publish to website". Leave them empty and the committed
# file is used as is.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Public site that hosts the published pages (default below).
NOTION_SITE=impartial-money-fa9.notion.site

# Vercel only: the project's Deploy Hook URL (Settings, Git) and the
# secret Vercel sends with cron calls. api/rebuild.js uses both for the
# hourly rebuild.
DEPLOY_HOOK_URL=
CRON_SECRET=
